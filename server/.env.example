NODE_ENV=development
HTTP_PORT=3000
# Port TCP sur lequel les FMC920 envoient leurs données (à configurer dans Teltonika Configurator > GPRS > Server settings)
TCP_PORT=5027
MONGO_URI=mongodb://127.0.0.1:27017/gestauto
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
AUTO_REGISTER_DEVICES=true
OFFLINE_AFTER_MINUTES=15
POSITIONS_RETENTION_DAYS=180
DOCUMENT_REMINDER_DAYS=30
LOG_LEVEL=info
